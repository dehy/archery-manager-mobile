{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:8080" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://app.staging.karkwa.fr" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://app.karkwa.fr" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6822074681" },
      "android": { "track": "alpha", "releaseStatus": "draft" }
    }
  }
}
